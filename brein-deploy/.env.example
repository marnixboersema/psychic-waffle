# =============================================================================
# Brein — Open WebUI configuration
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# Pinned Open WebUI image tag. Bump this + `docker compose pull && up -d` to upgrade.
# Releases: https://github.com/open-webui/open-webui/releases
WEBUI_DOCKER_TAG=v0.9.5

# Session signing key. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# -----------------------------------------------------------------------------
# Providers — OpenAI primary, Anthropic via OpenAI-compatible endpoint.
# Lists are semicolon-separated and must be the same length / order.
# -----------------------------------------------------------------------------
OPENAI_API_BASE_URLS=https://api.openai.com/v1;https://api.anthropic.com/v1
OPENAI_API_KEYS=sk-openai-REPLACE-ME;sk-ant-REPLACE-ME

# Models in the picker (first = default for new chats)
DEFAULT_MODELS=gpt-4o-mini,claude-sonnet-4-5

# -----------------------------------------------------------------------------
# Access control — signup disabled; admin creates accounts in Admin Panel > Users.
# -----------------------------------------------------------------------------
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=user

# -----------------------------------------------------------------------------
# Branding — title bar will show "Brein (Open WebUI)" (the suffix is hard-coded
# in source). The iPhone/Android home-screen tile reads pure "Brein" via the
# custom PWA manifest served by Caddy at /static/brein/manifest.webmanifest.
# -----------------------------------------------------------------------------
WEBUI_NAME=Brein
EXTERNAL_PWA_MANIFEST_URL=https://brein.marnixboersema.co.za/static/brein/manifest.webmanifest

# -----------------------------------------------------------------------------
# RAG embeddings via OpenAI (CX22 has no GPU; local embeddings would be slow).
# Set RAG_OPENAI_* explicitly — the documented fallback to the primary OPENAI_*
# is unreliable across versions (open-webui#22084).
# -----------------------------------------------------------------------------
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_OPENAI_API_KEY=sk-openai-REPLACE-ME
RAG_OPENAI_API_BASE_URL=https://api.openai.com/v1

# Single worker — Open WebUI's bundled Chroma doesn't support multi-worker.
UVICORN_WORKERS=1
